<%- include('./partials/app-start', {
    pageTitle: 'My Tasks',
    headerTitle: 'My Tasks',
    headerActionHref: '/tasks/create',
    headerActionLabel: '+ New Task'
}) %>

<div class="py-8">
    <div class="max-w-7xl mx-auto sm:px-6 lg:px-8">

        <!-- Filters -->
        <div class="mb-6 bg-white border border-gray-200 rounded-xl p-4">
            <form method="GET" action="/dashboard" class="grid grid-cols-1 md:grid-cols-4 gap-4">

                <!-- Search -->
                <div class="md:col-span-2">
                    <label class="block text-sm font-medium text-gray-700 mb-1">
                        Search
                    </label>
                    <input type="text" name="search" value="<%= search %>"
                        placeholder="Search by title or description..."
                        class="w-full rounded-lg border-gray-300 focus:ring-indigo-500 focus:border-indigo-500">
                </div>

                <!-- Status Filter -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">
                        Status
                    </label>
                    <select name="status"
                        class="w-full rounded-lg border-gray-300 focus:ring-indigo-500 focus:border-indigo-500">
                        <option value="">All</option>
                        <option value="to_do" <%= status === 'to_do' ? 'selected' : '' %>>To Do</option>
                        <option value="in_progress" <%= status === 'in_progress' ? 'selected' : '' %>>In Progress</option>
                        <option value="in_review" <%= status === 'in_review' ? 'selected' : '' %>>In Review</option>
                        <option value="completed" <%= status === 'completed' ? 'selected' : '' %>>Completed</option>
                    </select>
                </div>

                <!-- Sort -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">
                        Sort By
                    </label>
                    <select name="sort"
                        class="w-full rounded-lg border-gray-300 focus:ring-indigo-500 focus:border-indigo-500">
                        <option value="latest" <%= sort === 'latest' ? 'selected' : '' %>>Latest</option>
                        <option value="due_date" <%= sort === 'due_date' ? 'selected' : '' %>>Due Date</option>
                        <option value="priority" <%= sort === 'priority' ? 'selected' : '' %>>Priority</option>
                    </select>
                </div>

                <div class="md:col-span-4 flex items-center justify-between gap-3">
                    <div class="flex items-center gap-3">
                        <button type="submit"
                            class="px-4 py-2 bg-gray-900 hover:bg-gray-800 text-white rounded-lg text-sm font-semibold">
                            Apply
                        </button>

                        <a href="/dashboard"
                            class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-800 rounded-lg text-sm font-semibold">
                            Reset
                        </a>
                    </div>

                    <a href="/timesheets"
                       class="text-sm font-medium text-indigo-600 hover:text-indigo-700 whitespace-nowrap shrink-0">
                        Open Weekly Timesheets →
                    </a>
                </div>
            </form>
        </div>

        <!-- Tasks Table -->
        <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-semibold text-gray-600">
                                Title
                            </th>
                            <th class="px-6 py-3 text-left text-xs font-semibold text-gray-600">
                                Status
                            </th>
                            <th class="px-6 py-3 text-left text-xs font-semibold text-gray-600">
                                Priority
                            </th>
                            <th class="px-6 py-3 text-left text-xs font-semibold text-gray-600">
                                Logged
                            </th>
                            <th class="px-6 py-3 text-left text-xs font-semibold text-gray-600">
                                Due Date
                            </th>
                            <th class="px-6 py-3 text-right text-xs font-semibold text-gray-600">
                                Actions
                            </th>
                        </tr>
                    </thead>

                    <tbody class="divide-y divide-gray-200">
                        <% if (tasks.length > 0) { %>
                            <% tasks.forEach((task) => { %>
                                <% const loggedHrs = loggedHoursMap.get(task.id) || 0; %>
                                <tr class="hover:bg-gray-50">
                                    <td class="px-6 py-4">
                                        <div class="flex items-center gap-2">
                                            <span class="font-mono text-xs text-gray-400 tabular-nums shrink-0">TM-<%= task.id %></span>
                                            <a href="/tasks/<%= task.id %>" class="font-semibold text-gray-900 hover:text-indigo-600">
                                                <%= task.title %>
                                            </a>
                                        </div>

                                        <% if (task.description) { %>
                                            <div class="text-sm text-gray-500 mt-1">
                                                <%= h.truncate(task.description, 70) %>
                                            </div>
                                        <% } %>
                                    </td>

                                    <!-- Status Column -->
                                    <td class="px-6 py-4">
                                        <form method="POST" action="/tasks/<%= task.id %>/status">
                                            <input type="hidden" name="_method" value="PATCH">
                                            <select name="status" onchange="this.form.submit()"
                                                class="text-xs font-semibold rounded-lg border-gray-300 <%= task.status === 'completed' ? 'text-green-600' : 'text-gray-600' %>">
                                                <option value="to_do" <%= task.status === 'to_do' ? 'selected' : '' %>>To Do</option>
                                                <option value="in_progress" <%= task.status === 'in_progress' ? 'selected' : '' %>>In Progress</option>
                                                <option value="in_review" <%= task.status === 'in_review' ? 'selected' : '' %>>In Review</option>
                                                <option value="completed" <%= task.status === 'completed' ? 'selected' : '' %>>Completed</option>
                                            </select>
                                        </form>
                                    </td>

                                    <!-- Priority Column -->
                                    <td class="px-6 py-4">
                                        <form method="POST" action="/tasks/<%= task.id %>/priority">
                                            <input type="hidden" name="_method" value="PATCH">
                                            <select name="priority" onchange="this.form.submit()"
                                                class="text-xs border-none bg-transparent font-semibold">
                                                <option value="1" <%= task.priority === 1 ? 'selected' : '' %>>1 - Lowest</option>
                                                <option value="2" <%= task.priority === 2 ? 'selected' : '' %>>2 - Low</option>
                                                <option value="3" <%= task.priority === 3 ? 'selected' : '' %>>3 - Medium</option>
                                                <option value="4" <%= task.priority === 4 ? 'selected' : '' %>>4 - High</option>
                                                <option value="5" <%= task.priority === 5 ? 'selected' : '' %>>5 - Highest</option>
                                            </select>
                                        </form>
                                    </td>

                                    <!-- Logged Hours -->
                                    <td class="px-6 py-4">
                                        <a href="/timesheets?taskId=<%= task.id %>"
                                           class="font-mono tabular-nums text-xs font-medium <%= loggedHrs > 0 ? 'text-indigo-700 hover:underline' : 'text-gray-400 hover:text-gray-600' %>">
                                            <%= loggedHrs > 0 ? `${loggedHrs.toFixed(1)}h` : 'Log time' %>
                                        </a>
                                    </td>

                                    <!-- Due Date -->
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <span class="text-sm text-gray-700 font-mono tabular-nums">
                                            <%= h.formatDate(task.due_date) %>
                                        </span>

                                        <% if (h.isOverdue(task)) { %>
                                            <span class="ml-2 text-xs font-semibold text-red-600">
                                                Overdue
                                            </span>
                                        <% } %>
                                    </td>

                                    <!-- Actions -->
                                    <td class="px-6 py-4">
                                        <div class="flex justify-end items-center gap-2">
                                            <a href="/timesheets?taskId=<%= task.id %>"
                                                class="px-3 py-1.5 rounded-lg text-xs font-semibold bg-indigo-50 hover:bg-indigo-100 text-indigo-700 whitespace-nowrap shrink-0">
                                                Log Time
                                            </a>

                                            <a href="/tasks/<%= task.id %>"
                                                class="px-3 py-1.5 rounded-lg text-xs font-semibold bg-green-100 hover:bg-green-200 text-green-800 whitespace-nowrap shrink-0">
                                                View
                                            </a>

                                            <a href="/tasks/<%= task.id %>/edit"
                                                class="px-3 py-1.5 rounded-lg text-xs font-semibold bg-yellow-100 hover:bg-yellow-200 text-yellow-800 whitespace-nowrap shrink-0">
                                                Edit
                                            </a>

                                            <form action="/tasks/<%= task.id %>" method="POST" class="delete-form">
                                                <input type="hidden" name="_method" value="DELETE">
                                                <button type="button"
                                                    class="delete-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-red-100 hover:bg-red-200 text-red-800 whitespace-nowrap shrink-0">
                                                    Delete
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="6" class="px-6 py-10 text-center text-gray-500">
                                    No tasks found. Create your first task 🚀
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            <% if (pagination.total > 0) { %>
                <%
                    const buildPageUrl = (pageNum) => {
                        const params = new URLSearchParams();
                        if (search) params.set('search', search);
                        if (status) params.set('status', status);
                        if (sort) params.set('sort', sort);
                        params.set('page', String(pageNum));
                        return '/dashboard?' + params.toString();
                    };
                %>
                <div class="p-4 border-t border-gray-200 flex flex-col sm:flex-row items-center justify-between gap-3">
                    <p class="text-sm text-gray-700">
                        Showing <span class="font-medium font-mono tabular-nums"><%= pagination.from %></span>
                        to <span class="font-medium font-mono tabular-nums"><%= pagination.to %></span>
                        of <span class="font-medium font-mono tabular-nums"><%= pagination.total %></span> results
                    </p>

                    <% if (pagination.lastPage > 1) { %>
                        <nav class="inline-flex rounded-md shadow-sm -space-x-px" aria-label="Pagination">
                            <% if (pagination.hasPrev) { %>
                                <a href="<%= buildPageUrl(pagination.currentPage - 1) %>"
                                   class="relative inline-flex items-center px-3 py-2 rounded-l-md border border-gray-300 bg-white text-sm font-medium text-gray-700 hover:bg-gray-50">
                                    Previous
                                </a>
                            <% } else { %>
                                <span class="relative inline-flex items-center px-3 py-2 rounded-l-md border border-gray-300 bg-gray-100 text-sm font-medium text-gray-400 cursor-not-allowed">
                                    Previous
                                </span>
                            <% } %>

                            <% for (let p = 1; p <= pagination.lastPage; p++) { %>
                                <a href="<%= buildPageUrl(p) %>"
                                   class="relative inline-flex items-center px-4 py-2 border text-sm font-medium font-mono tabular-nums <%= p === pagination.currentPage ? 'z-10 bg-indigo-50 border-indigo-500 text-indigo-600' : 'bg-white border-gray-300 text-gray-700 hover:bg-gray-50' %>">
                                    <%= p %>
                                </a>
                            <% } %>

                            <% if (pagination.hasNext) { %>
                                <a href="<%= buildPageUrl(pagination.currentPage + 1) %>"
                                   class="relative inline-flex items-center px-3 py-2 rounded-r-md border border-gray-300 bg-white text-sm font-medium text-gray-700 hover:bg-gray-50">
                                    Next
                                </a>
                            <% } else { %>
                                <span class="relative inline-flex items-center px-3 py-2 rounded-r-md border border-gray-300 bg-gray-100 text-sm font-medium text-gray-400 cursor-not-allowed">
                                    Next
                                </span>
                            <% } %>
                        </nav>
                    <% } %>
                </div>
            <% } %>
        </div>

    </div>
</div>

<%- include('./partials/app-end') %>
