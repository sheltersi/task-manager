<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('./partials/head', { pageTitle: `${statusCode} Error` }) %>
</head>
<body class="bg-gray-100 font-sans antialiased">
    <div class="min-h-screen flex flex-col items-center justify-center px-6">
        <div class="max-w-md w-full bg-white shadow rounded-2xl p-8 text-center">
            <p class="text-sm font-semibold text-indigo-600 uppercase tracking-wider">Error <%= statusCode %></p>
            <h1 class="mt-2 text-2xl font-bold text-gray-900"><%= message %></h1>
            <div class="mt-6 flex items-center justify-center gap-3">
                <a href="/dashboard"
                   class="px-4 py-2 rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold">
                    Go to Dashboard
                </a>
                <a href="/"
                   class="px-4 py-2 rounded-lg bg-gray-100 hover:bg-gray-200 text-gray-800 text-sm font-semibold">
                    Home
                </a>
            </div>
        </div>
    </div>
</body>
</html>
